PORT=3000
NODE_ENV=production
SESSION_SECRET=genera-un-secreto-largo-y-aleatorio

# En Render: pegar la Internal Database URL de PostgreSQL
# DATABASE_URL=postgresql://...

# Admin inicial en Render (Environment del web service)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Una vez: poner true, redeploy, entrar, luego quitar o poner false
# ADMIN_RESET_PASSWORD=true
